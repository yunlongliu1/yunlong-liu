# Shopify Admin API — nozloo store
# --------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real token. NEVER commit `.env`.
#
#   Store handle : nozloo          (admin.shopify.com/store/nozloo)
#   Storefront   : nozloo.com
#   App          : Claude Admin    (dev.shopify.com org 209023901)
#
# IRON RULE: API calls MUST target the *.myshopify.com API domain below
# (r8hi1q-rx.myshopify.com) — NOT nozloo.myshopify.com.
# --------------------------------------------------------------------------

SHOPIFY_STORE_DOMAIN=r8hi1q-rx.myshopify.com
SHOPIFY_API_VERSION=2024-10

# Admin API access token (starts with shpat_). This is the ONLY credential
# required to authenticate Admin API calls. Treat it like a password.
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App identity — only needed for OAuth / webhook HMAC verification,
# NOT for Admin API calls. Optional.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=


# Google Search Console (Webmasters v3) — nozloo.com
# --------------------------------------------------------------------------
# OAuth 2.0 credentials. The refresh token is minted once via browser consent
# (see gsc/README.md). NEVER commit real values — keep them in `.env`.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_PROJECT_ID=my-project-6202-1762606633672

# Long-lived refresh token from `node gsc/cli.mjs exchange <code>`.
GOOGLE_REFRESH_TOKEN=

# Property + scope (defaults shown). Run `node gsc/cli.mjs sites` to confirm
# the exact property string (sc-domain:nozloo.com vs https://nozloo.com/).
GSC_SITE_URL=sc-domain:nozloo.com
GSC_SCOPE=https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_REDIRECT_URI=http://localhost
