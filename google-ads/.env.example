# ---------------------------------------------------------------------------
# Google Ads API 凭据
#
# 用法：cp .env.example .env  然后填写下面的值。
# .env 已被 .gitignore 忽略，绝对不要把它提交进仓库。
# ---------------------------------------------------------------------------

# 1) 开发者令牌
#    来源：Google Ads 后台 → 管理 → API 中心 → 开发者令牌
#    （就是你截图里 "开发者令牌" 那一行的值）
GOOGLE_ADS_DEVELOPER_TOKEN=

# 2) OAuth 2.0 客户端凭据
#    来源：Google Cloud Console → API 和服务 → 凭据 → 创建 OAuth 客户端 ID
#    应用类型选择「桌面应用 / Desktop app」
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# 3) 刷新令牌
#    由 `python oauth_setup.py` 生成后填在这里
GOOGLE_ADS_REFRESH_TOKEN=

# 4) 经理账号（MCC）ID —— 只有当你通过经理账号访问子账号时才需要填。
#    截图中的账号是 851-773-3884，如果它是经理账号就填这里。
#    横杠可填可不填，代码会自动去掉。
GOOGLE_ADS_LOGIN_CUSTOMER_ID=851-773-3884

# 5) 实际要操作/查询的广告账号 ID。
#    如果直接操作经理账号本身，就和上面填一样；
#    如果要操作子账号，填子账号 ID（运行 test_connection.py 会列出所有可用账号）。
GOOGLE_ADS_CUSTOMER_ID=851-773-3884
